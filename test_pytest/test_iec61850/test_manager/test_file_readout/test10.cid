            <DOI desc="004.091:ASC  :Volt. magnit. diff." name="DifVClc">
              <SDI name="units">
                <DAI name="SIUnit">
                  <Val />
                </DAI>
                <DAI name="multiplier" valImport="true">
                  <Val></Val>
                </DAI>
