              <SDI name="rangeC">
                <Private type="ConfigurableAttributes">hhLim:0,hLim:0,lLim:0,llLim:0,max:3,min:-3</Private>
                <SDI name="hhLim">
                  <DAI name="f">
                    <Val>0</Val>
                  </DAI>
                </SDI>
                <SDI name="hLim">
                  <DAI name="f">
                    <Val>0</Val>
                  </DAI>
